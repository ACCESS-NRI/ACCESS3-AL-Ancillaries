        "RESOLUTION":              JULES_STANDALONE_RESOLUTION | default(none),
        "LAND_SEA_MASK":           JULES_STANDALONE_LAND_SEA_MASK | default(none),
        "LAND_FRACTIONS":          JULES_STANDALONE_LAND_FRACTIONS | default(none),
        "SOIL_INIT_CONDS_METHOD":  JULES_STANDALONE_SOIL_INIT_CONDS_METHOD | default(none),
        "AEROSOLS":                JULES_STANDALONE_AEROSOLS | default(none),
        "VERTICAL_DISCRETIZATION": JULES_STANDALONE_VERTICAL_DISCRETIZATION | default(none),
        "BEGIN_YEAR":              JULES_STANDALONE_BEGIN_YEAR | default(none),
        "END_YEAR":                JULES_STANDALONE_END_YEAR | default(none),
    } %}
{% endif %}
