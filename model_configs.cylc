    "ACCESS-AM3": {
        "LAND_MODEL": AM3_LAND_MODEL,
        "GRID_SOURCE": AM3_GRID_SOURCE,
        "ATMOSPHERE_ANCILLARIES": AM3_ATMOSPHERE_ANCILLARIES,
        "AEROSOLS": AM3_AEROSOLS,
        "CALENDAR": AM3_CALENDAR,
    },
    "ACCESS-rAM3": {
        "LAND_MODEL": RAM3_LAND_MODEL,
        "GRID_SOURCE": RAM3_GRID_SOURCE,
        "ATMOSPHERE_ANCILLARIES": RAM3_ATMOSPHERE_ANCILLARIES,
        "AEROSOLS": RAM3_AEROSOLS,
        "CALENDAR": RAM3_CALENDAR,
    },
    "ACCESS-rCM3": {
        "LAND_MODEL": RCM3_LAND_MODEL,
        "GRID_SOURCE": RCM3_GRID_SOURCE,
        "ATMOSPHERE_ANCILLARIES": RCM3_ATMOSPHERE_ANCILLARIES,
        "AEROSOLS": RCM3_AEROSOLS,
        "CALENDAR": RCM3_CALENDAR,
    },
    "CABLE-standalone": {
        "LAND_MODEL": CABLE_STANDALONE_LAND_MODEL,
        "GRID_SOURCE": CABLE_STANDALONE_GRID_SOURCE,
        "ATMOSPHERE_ANCILLARIES": CABLE_STANDALONE_ATMOSPHERE_ANCILLARIES,
        "AEROSOLS": CABLE_STANDALONE_AEROSOLS,
        "CALENDAR": CABLE_STANDALONE_CALENDAR,
    },
    "JULES-standalone": {
        "LAND_MODEL": JULES_STANDALONE_LAND_MODEL,
        "GRID_SOURCE": JULES_STANDALONE_GRID_SOURCE,
        "ATMOSPHERE_ANCILLARIES": JULES_STANDALONE_ATMOSPHERE_ANCILLARIES,
        "AEROSOLS": JULES_STANDALONE_AEROSOLS,
        "CALENDAR": JULES_STANDALONE_CALENDAR,
    },
} %}
